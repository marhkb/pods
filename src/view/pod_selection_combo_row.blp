using Gtk 4.0;
using Adw 1;

template $PdsPodSelectionComboRow: Adw.ActionRow {
  notify::pod-list => $on_notify_pod_list() swapped;
  activatable-widget: switch;
  selected-pod: bind drop_down.selected-item;

  DropDown drop_down {
    enable-search: true;
    expression: expr item as <$PdsPod>.name;
    visible: bind switch.active;

    factory: BuilderListItemFactory {
      template ListItem {
        child: Label {
          label: bind template.item as <$PdsPod>.name;
          xalign: 0;
        };
      }
    };
  }

  Switch switch {
    active: bind template.active bidirectional;
    valign: center;
  }
}
