using Gtk 4.0;

menu menu {
  section {
    item {
      label: _("_Copy to Clipboard");
      action: "repo-tag-row.copy-to-clipboard";
    }

    item {
      label: _("_Pull Latest");
      action: "repo-tag-row.update";
    }

    item {
      label: _("P_ush to Registry…");
      action: "repo-tag-row.push";
    }
  }

  section {
    item {
      label: _("_Untag");
      action: "repo-tag-row.untag";
    }
  }
}

template $PdsRepoTagRow: ListBoxRow {
  selectable: false;
  activatable: false;
  height-request: 55;

  Box {
    margin-top: 7;
    margin-end: 12;
    margin-bottom: 8;
    margin-start: 12;
    spacing: 6;

    Label {
      label: bind $repo_tag_markup(
        template.repo_tag as <$PdsRepoTag>.full,
        template.repo_tag as <$PdsRepoTag>.to-be-deleted
        ) as <string>;
      use-markup: true;
      hexpand: true;
      xalign: 0;
      wrap: true;
      wrap-mode: word_char;
    }

    MenuButton {
      styles [
        "flat",
      ]

      icon-name: "view-more-symbolic";
      menu-model: menu;
      tooltip-text: _("Tag Actions");
      valign: center;

      accessibility {
        label: _("Tag Actions");
      }
    }
  }
}
