using Gtk 4.0;

template $PdsRepoTagRow: ListBoxRow {
  selectable: false;
  activatable: false;
  height-request: 55;

  Box {
    margin-top: 7;
    margin-end: 12;
    margin-bottom: 8;
    margin-start: 12;

    Label {
      label: bind $repo_tag_markup(
        template.repo_tag as <$PdsRepoTag>.full,
        template.repo_tag as <$PdsRepoTag>.to-be-deleted
        ) as <string>;
      use-markup: true;
      selectable: true;
      hexpand: true;
      xalign: 0;
      wrap: true;
      wrap-mode: word_char;
    }

    Button {
      styles [
        "flat",
      ]

      action-name: "repo-tag-row.update";
      icon-name: "download-symbolic";
      tooltip-text: _("Pull Latest");

      accessibility {
        label: _("Pull Latest");
      }
    }

    Button {
      styles [
        "flat",
      ]

      action-name: "repo-tag-row.push";
      icon-name: "upload-symbolic";
      tooltip-text: _("Push to Registry");

      accessibility {
        label: _("Push to Registry");
      }
    }

    Button {
      styles [
        "flat",
      ]

      action-name: "repo-tag-row.untag";
      icon-name: "edit-delete-symbolic";
      tooltip-text: _("Untag");

      accessibility {
        label: _("Untag");
      }
    }
  }
}
