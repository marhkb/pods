using Gtk 4.0;
using Adw 1;

template $PdsVolumeDetailsPage: Widget {
  layout-manager: BinLayout {};

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [title]
      Adw.WindowTitle window_title {
        title: _("Volume");
      }
    }

    Adw.PreferencesPage {
      Adw.PreferencesGroup {
        title: _("Properties");

        header-suffix: Button {
          styles [
            "circular",
            "destructive-button",
          ]

          action-name: "volume-details-page.delete-volume";
          icon-name: "user-trash-symbolic";
          margin-bottom: 6;
          tooltip-text: _("Delete Volume");

          accessibility {
            label: _("Delete Volume");
          }
        };

        Adw.ActionRow name_row {
          styles [
            "property",
          ]

          title: _("Name");

          Button {
            styles [
              "flat",
            ]

            action-name: "volume-details-page.copy-name-to-clipboard";
            icon-name: "edit-copy-symbolic";
            tooltip-text: _("Copy to clipboard");

            accessibility {
              label: _("Copy name to clipboard");
            }

            valign: center;
          }
        }

        Adw.ActionRow mountpoint_row {
          styles [
            "property",
          ]

          title: _("Mount Path");

          Button open_mount_path_button {
            styles [
              "flat",
            ]

            action-name: "volume-details-page.open-mount-path";
            icon-name: "external-link-symbolic";
            tooltip-text: _("Open in file manager");

            accessibility {
              label: _("Open mount path in file manager");
            }

            valign: center;
          }

          Button {
            styles [
              "flat",
            ]

            action-name: "volume-details-page.copy-mount-path-to-clipboard";
            icon-name: "edit-copy-symbolic";
            tooltip-text: _("Copy to clipboard");

            accessibility {
              label: _("Copy mount path to clipboard");
            }

            valign: center;
          }
        }

        Adw.ActionRow driver_row {
          styles [
            "property",
          ]

          title: _("Driver");
        }

        Adw.ActionRow created_row {
          styles [
            "property",
          ]

          title: _("Created");
        }
      }

      Adw.PreferencesGroup {
        title: _("Utilities");

        Adw.ActionRow {
          title: _("Inspection");
          subtitle: _("View all volume properties in a structured text form");
          activatable: true;
          action-name: "volume-details-page.inspect-volume";
          icon-name: "system-search-symbolic";

          Image {
            icon-name: "go-next-symbolic";
            accessible-role: presentation;
          }
        }
      }

      $PdsContainersGroup {
        container-list: bind template.volume as <$PdsVolume>.containers;
        title: _("Containers");
      }
    }
  }
}
