using Gtk 4.0;

template $PdsRepoTagSimpleRow: ListBoxRow {
  activatable: false;
  focusable: false;
  selectable: false;

  Box {
    spacing: 5;

    Image {
      styles [
        "dimmed",
      ]

      accessible-role: presentation;
      icon-name: "tag-symbolic";
      margin-top: 3;
      pixel-size: 12;
      valign: start;
    }

    Label {
      styles [
        "title",
      ]

      label: bind template.repo_tag as <$PdsRepoTag>.full;
      hexpand: true;
      wrap: true;
      wrap-mode: word_char;
      xalign: 0;
    }
  }
}
