using Gtk 4.0;
using Adw 1;

template $PdsRepoTagSimpleRow: ListBoxRow {
  activatable: false;
  focusable: false;
  selectable: false;

  Adw.WrapBox {
    child-spacing: 3;

    Label {
      styles [
        "subtitle",
      ]

      label: bind template.repo_tag as <$PdsRepoTag>.repo;
      xalign: 0;
      wrap: true;
      wrap-mode: word_char;
    }

    Label {
      styles [
        "subtitle",
        "undimmed",
        "accent",
      ]

      label: bind template.repo_tag as <$PdsRepoTag>.tag;
      xalign: 0;
      wrap: true;
      wrap-mode: word_char;
    }
  }
}
