using Gtk 4.0;
using Adw 1;

SizeGroup {
  mode: horizontal;

  widgets [
    cancel_button,
    create_button,
  ]
}

template $PdsPodCreateOptsDialog: Adw.Dialog {
  default-widget: create_button;
  focus-widget: name_entry_row;
  title: _("Create Pod");
  width-request: 360;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-end-title-buttons: false;
      show-start-title-buttons: false;

      [start]
      Button cancel_button {
        action-name: "win.close";
        label: _("_Cancel");
        use-underline: true;
      }

      [end]
      Button create_button {
        styles [
          "suggested-action",
        ]

        action-name: "pod-create-opts-dialog.create";
        label: _("_Create");
        use-underline: true;
      }
    }

    Adw.PreferencesPage {
      Adw.PreferencesGroup {
        $PdsRandomNameEntryRow name_entry_row {
          changed => $on_name_entry_row_changed() swapped;
          activates-default: "True";
          title: _("Name");
        }
      }

      Adw.PreferencesGroup {
        Adw.ToggleGroup {
          active-name: bind stack.visible-child-name bidirectional;
          can-shrink: true;
          homogeneous: true;
          margin-top: 12;

          styles [
            "round",
          ]

          Adw.Toggle {
            name: "details";
            label: _("Details");
          }

          Adw.Toggle {
            name: "integration";
            label: _("Integration");
          }

          Adw.Toggle {
            name: "infra";
            label: _("Infra");
          }
        }
      }

      Adw.PreferencesGroup {
        Adw.ViewStack stack {
          vhomogeneous: false;

          Adw.ViewStackPage {
            name: "details";
            title: _("Details");

            child: Box {
              orientation: vertical;
              spacing: 18;

              Adw.PreferencesGroup {
                Adw.EntryRow hostname_entry_row {
                  activates-default: true;
                  title: _("Hostname");
                }

                Adw.SwitchRow disable_resolv_switch_row {
                  title: _("Disable /etc/resolv.conf Management");
                  notify::active => $on_disable_resolv_switch_row_active_changed() swapped;
                }
              }

              Adw.PreferencesGroup {
                Adw.EntryRow create_command_entry_row {
                  activates-default: true;
                  title: _("Pod Create Command");
                }
              }
            };
          }

          Adw.ViewStackPage {
            name: "integration";
            title: _("Integration");

            child: Box {
              orientation: vertical;
              spacing: 18;

              Adw.PreferencesGroup {
                title: _("Ports");

                ListBox port_mapping_list_box {
                  styles [
                    "boxed-list",
                  ]
                }
              }

              Adw.PreferencesGroup {
                title: _("Devices");

                ListBox devices_list_box {
                  styles [
                    "boxed-list",
                  ]
                }
              }

              Adw.PreferencesGroup {
                title: _("Hosts");

                header-suffix: Switch enable_hosts_switch {
                  accessibility {
                    label: _("Hosts");
                  }

                  notify::active => $on_enable_hosts_switch_active_changed() swapped;
                  valign: center;
                  active: true;
                };

                ListBox hosts_list_box {
                  styles [
                    "boxed-list",
                  ]
                }
              }

              Adw.PreferencesGroup {
                title: _("Labels");

                ListBox labels_list_box {
                  styles [
                    "boxed-list",
                  ]
                }
              }
            };
          }

          Adw.ViewStackPage {
            name: "infra";
            title: _("Infra");

            child: Box {
              orientation: vertical;
              spacing: 18;

              Adw.PreferencesGroup {
                Adw.SwitchRow disable_infra_switch_row {
                  notify::active => $on_disable_infra_switch_row_active_changed() swapped;
                  title: _("Disable Infra");
                }
              }

              Box infra_settings_box {
                orientation: vertical;
                spacing: 18;

                Adw.PreferencesGroup {
                  Adw.EntryRow infra_name_entry_row {
                    activates-default: true;
                    title: _("Name");
                  }

                  $PdsImageSuggestionEntryRow infra_image_suggestion_entry_row {
                    title: _("Image");
                  }

                  Adw.SwitchRow infra_pull_latest_image_switch_row {
                    title: _("Pull Latest Image");
                  }

                  Adw.EntryRow infra_common_pid_file_entry_row {
                    activates-default: true;
                    title: _("Common PID File");
                  }
                }

                Adw.PreferencesGroup {
                  Adw.EntryRow infra_command_entry_row {
                    activates-default: true;
                    title: _("Command");
                  }
                }
              }
            };
          }
        }
      }
    }
  }
}
