using Gtk 4.0;

menu menu {
  section {
    item {
      label: _("_Open Host Path in File Manager");
      action: "container-volume-row.open-host-path";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("Copy _Host Path");
      action: "container-volume-row.copy-host-path";
    }

    item {
      label: _("Copy _Container Path");
      action: "container-volume-row.copy-container-path";
    }
  }
}

template $PdsContainerVolumeRow: ListBoxRow {
  action-name: "container-volume-row.show-details";
  height-request: 55;

  Box {
    margin-top: 7;
    margin-end: 12;
    margin-bottom: 8;
    margin-start: 12;
    spacing: 9;

    Box {
      spacing: 6;

      Box {
        hexpand: true;
        valign: center;
        orientation: vertical;
        spacing: 3;

        Label name_label {
          use-markup: true;
          wrap-mode: word_char;
          wrap: true;
          xalign: 0;
          yalign: 0;
        }

        Label {
          styles [
            "subtitle",
          ]

          label: bind $format_path(
            template.container-volume as <$PdsContainerVolume>.destination,
            template.container-volume as <$PdsContainerVolume>.rw,
            template.container-volume as <$PdsContainerVolume>.mode
            ) as <string>;
          wrap: true;
          wrap-mode: word_char;
          xalign: 0;
        }
      }

      $PdsContainersCountBar containers_count_bar {}

      MenuButton {
        styles [
          "flat",
        ]

        icon-name: "view-more-symbolic";
        menu-model: menu;
        tooltip-text: _("Volume Actions");
        valign: center;

        accessibility {
          label: _("Volume Actions");
        }
      }
    }

    Image {
      icon-name: "go-next-symbolic";
      accessible-role: presentation;
    }
  }
}
