using Gtk 4.0;
using Adw 1;

Adw.ButtonRow create_container_row {
  action-name: "containers-group.create-container";
  selectable: false;
  start-icon-name: "list-add-symbolic";
  title: _("Add Container");
}

template $PdsContainersGroup: Adw.PreferencesGroup {
  ListBox list_box {
    styles [
      "boxed-list",
    ]

    selection-mode: none;
  }
}
