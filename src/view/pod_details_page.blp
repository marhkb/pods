using Gtk 4.0;
using Adw 1;

template $PdsPodDetailsPage: Widget {
  layout-manager: BinLayout {};

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Label status_label {
        styles [
          "status-badge",
        ]

        margin-top: 4;
        margin-bottom: 4;
      }

      [title]
      Adw.WindowTitle {
        title: _("Pod");
        subtitle: bind template.pod as <$Pod>.name;
      }
    }

    [top]
    CenterBox action_center_box {
      halign: center;
      margin-start: 24;
      margin-top: 9;
      margin-end: 24;
      margin-bottom: 6;
      width-request: 312;

      [start]
      Button {
        styles [
          "circular",
          "raised",
        ]

        action-name: "pod-details-page.kill";
        icon-name: "skull-symbolic";
        tooltip-text: _("Kill");

        accessibility {
          label: _("Kill");
        }

        valign: center;
      }

      [center]
      Box {
        halign: center;
        hexpand: true;
        spacing: 12;

        Button {
          styles [
            "circular",
            "raised",
          ]

          action-name: "pod-details-page.restart";
          icon-name: "view-refresh-symbolic";
          tooltip-text: _("Restart");

          accessibility {
            label: _("Restart");
          }

          valign: center;
        }

        Button start_or_resume_button {
          styles [
            "circular",
            "large",
            "raised",
          ]

          action-name: "pod-details-page.start";
          tooltip-text: _("Start/Resume");
          valign: center;

          Image {
            icon-name: "media-playback-start-symbolic";
          }
        }

        Button stop_button {
          styles [
            "circular",
            "large",
            "raised",
          ]

          action-name: "pod-details-page.stop";
          tooltip-text: _("Stop");
          valign: center;

          Image {
            icon-name: "media-playback-stop-symbolic";
          }
        }

        Button spinning_button {
          styles [
            "circular",
            "large",
            "raised",
          ]

          sensitive: false;
          valign: center;

          Adw.Spinner {}
        }

        Button {
          styles [
            "circular",
            "raised",
          ]

          action-name: "pod-details-page.pause";
          icon-name: "media-playback-pause-symbolic";
          tooltip-text: _("Pause");

          accessibility {
            label: _("Pause");
          }

          valign: center;
        }
      }

      [end]
      Button {
        styles [
          "circular",
          "destructive-button",
          "raised",
        ]

        action-name: "pod-details-page.delete";
        icon-name: "user-trash-symbolic";
        tooltip-text: _("Delete");

        accessibility {
          label: _("Delete");
        }

        valign: center;
      }
    }

    Stack stack {
      StackPage {
        name: "loading";

        child: Adw.Spinner {};
      }

      StackPage {
        name: "loaded";

        child: Adw.PreferencesPage preferences_page {
          Adw.PreferencesGroup {
            title: _("Properties");

            Adw.ActionRow {
              styles [
                "property",
              ]

              title: _("Name");
              subtitle: bind template.pod as <$Pod>.name;
            }

            Adw.ActionRow id_row {
              styles [
                "property",
              ]

              title: _("Id");
            }

            Adw.ActionRow created_row {
              styles [
                "property",
              ]

              title: _("Created");
            }

            Adw.ActionRow hostname_row {
              styles [
                "property",
              ]

              title: _("Hostname");
            }
          }

          Adw.PreferencesGroup ports_group {
            title: _("Ports");

            ListBox ports_list_box {
              styles [
                "boxed-list",
              ]

              selection-mode: none;
            }
          }

          Adw.PreferencesGroup {
            title: _("Utilities");

            Adw.ActionRow {
              title: _("Inspection");
              subtitle: _("View all pod properties in a structured text form");
              activatable: true;
              action-name: "pod-details-page.inspect-pod";
              icon-name: "system-search-symbolic";

              Image {
                icon-name: "go-next-symbolic";
              }
            }

            Adw.ActionRow {
              title: _("Kube");
              subtitle: _("Generate Kubernetes YAML based on this pod");
              activatable: true;
              action-name: "pod-details-page.generate-kube";
              icon-name: "code-symbolic";

              Image {
                icon-name: "go-next-symbolic";
              }
            }

            Adw.ActionRow {
              title: _("Processes");
              subtitle: _("View processes of the pod");
              activatable: true;
              action-name: "pod-details-page.show-processes";
              icon-name: "application-x-executable-symbolic";

              Image {
                icon-name: "go-next-symbolic";
              }
            }
          }

          $PdsContainersGroup {
            container-list: bind template.pod as <$Pod>.container-list;
            title: _("Containers");
          }
        };
      }
    }
  }
}
