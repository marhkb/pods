using Gtk 4.0;
using Adw 1;

Adw.ButtonRow create_volume_row {
  action-name: "volumes-group.create-volume";
  selectable: false;
  start-icon-name: "list-add-symbolic";
  title: _("Add Volume");
}

template $PdsVolumesGroup: Adw.PreferencesGroup {
  ListBox list_box {
    styles [
      "boxed-list",
    ]

    selection-mode: none;
  }
}
