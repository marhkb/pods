using Gtk 4.0;
using Adw 1;

template $PdsContainerDetailsPage: Widget {
  layout-manager: BinLayout {};

  Adw.ToolbarView {
    [top]
    Adw.BreakpointBin {
      height-request: 1;
      width-request: 360;

      Adw.Breakpoint {
        condition ("max-width: 668sp")

        setters {
          status_since_label.visible: false;
        }
      }

      Adw.HeaderBar {
        [start]
        Box {
          margin-top: 4;
          margin-bottom: 4;
          spacing: 4;

          Label status_label {
            styles [
              "status-badge",
            ]
          }

          Label status_since_label {
            styles [
              "dimmed",
            ]
          }
        }

        [title]
        Adw.WindowTitle {
          title: _("Container");
          subtitle: bind template.container as <$Container>.name;
        }
      }
    }

    [top]
    CenterBox action_center_box {
      halign: center;
      margin-start: 24;
      margin-top: 9;
      margin-end: 24;
      margin-bottom: 6;
      width-request: 312;

      [start]
      Button {
        styles [
          "circular",
          "raised",
        ]

        action-name: "container-details-page.kill";
        icon-name: "skull-symbolic";
        tooltip-text: _("Kill");

        accessibility {
          label: _("Kill");
        }

        valign: center;
      }

      [center]
      Box {
        halign: center;
        hexpand: true;
        spacing: 12;

        Button {
          styles [
            "circular",
            "raised",
          ]

          action-name: "container-details-page.restart";
          icon-name: "view-refresh-symbolic";
          tooltip-text: _("Restart");

          accessibility {
            label: _("Restart");
          }

          valign: center;
        }

        Button start_or_resume_button {
          styles [
            "circular",
            "large",
            "raised",
          ]

          action-name: "container-details-page.start";
          tooltip-text: _("Start/Resume");
          valign: center;

          Image {
            icon-name: "media-playback-start-symbolic";
          }
        }

        Button stop_button {
          styles [
            "circular",
            "large",
            "raised",
          ]

          action-name: "container-details-page.stop";
          tooltip-text: _("Stop");
          valign: center;

          Image {
            icon-name: "media-playback-stop-symbolic";
          }
        }

        Button spinning_button {
          styles [
            "circular",
            "large",
            "raised",
          ]

          sensitive: false;
          valign: center;

          Adw.Spinner {}
        }

        Button {
          styles [
            "circular",
            "raised",
          ]

          action-name: "container-details-page.pause";
          icon-name: "media-playback-pause-symbolic";
          tooltip-text: _("Pause");

          accessibility {
            label: _("Pause");
          }

          valign: center;
        }
      }

      [end]
      Button {
        styles [
          "circular",
          "destructive-button",
          "raised",
        ]

        action-name: "container-details-page.delete";
        icon-name: "user-trash-symbolic";
        tooltip-text: _("Delete");

        accessibility {
          label: _("Delete");
        }

        valign: center;
      }
    }

    Stack stack {
      StackPage {
        name: "loading";

        child: Adw.Spinner {};
      }

      StackPage {
        name: "loaded";

        child: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            Adw.ActionRow image_action_row {
              styles [
                "property",
              ]

              action-name: "container-details-page.show-image-details";
              activatable: true;
              subtitle-lines: 2;
              title: _("Image");

              Image {
                icon-name: "go-next-symbolic";
              }
            }
          }

          Adw.PreferencesGroup pod_preferences_group {
            Adw.ActionRow pod_action_row {
              styles [
                "property",
              ]

              title: _("Pod");
              action-name: "container-details-page.show-pod-details";
              activatable: true;

              Image {
                icon-name: "go-next-symbolic";
              }
            }
          }

          $PdsContainerPropertiesGroup {
            container: bind template.container;
          }

          Adw.PreferencesGroup volumes_group {
            title: _("Volumes");

            ListBox volumes_list_box {
              styles [
                "boxed-list",
              ]

              selection-mode: none;
            }
          }

          Adw.PreferencesGroup {
            title: _("Utilities");

            Adw.ActionRow {
              title: _("Inspection");
              subtitle: _("View all container properties in a structured text form");
              activatable: true;
              action-name: "container-details-page.inspect";
              icon-name: "system-search-symbolic";

              Image {
                icon-name: "go-next-symbolic";
              }
            }

            Adw.ActionRow kube_generation_row {
              title: _("Kube");
              subtitle: _("Generate Kubernetes YAML based on this container");
              activatable: true;
              action-name: "container-details-page.generate-kube";
              icon-name: "code-symbolic";
              visible: bind template
                .container as <$Container>
                .container_list as <$ContainerList>
                .client as <$Client>
                .engine as <$Engine>
                .capabilities as <$EngineCapabilities>
                .kube_generation;

              Image {
                icon-name: "go-next-symbolic";
              }
            }

            Adw.ActionRow {
              title: _("Terminal");
              subtitle: _("Connect to the container's terminal");
              activatable: true;
              action-name: "container-details-page.show-tty";
              icon-name: "utilities-terminal-symbolic";

              Image {
                icon-name: "go-next-symbolic";
              }
            }

            Adw.ActionRow {
              title: _("Logs");
              subtitle: _("View and search through container logs");
              activatable: true;
              action-name: "container-details-page.show-log";
              icon-name: "text-editor-symbolic";

              Image {
                icon-name: "go-next-symbolic";
              }
            }

            Adw.ActionRow {
              title: _("Processes");
              subtitle: _("View and manage processes of the container");
              activatable: true;
              action-name: "container-details-page.show-processes";
              icon-name: "application-x-executable-symbolic";

              Image {
                icon-name: "go-next-symbolic";
              }
            }
          }

          $PdsContainerResources resources {
            container: bind template.container;
          }
        };
      }
    }
  }
}
