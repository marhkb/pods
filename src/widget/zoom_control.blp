using Gtk 4.0;

template $PdsZoomControl: Widget {
  layout-manager: BoxLayout {
    spacing: 3;
  };

  margin-start: 6;
  margin-end: 6;

  Button {
    action-name: bind template.zoom-out-action-name bidirectional;

    styles [
      "circular",
      "flat",
    ]

    icon-name: "zoom-out-symbolic";
    tooltip-text: _("Zoom Out");
  }

  Button zoom_normal_button {
    action-name: bind template.zoom-normal-action-name bidirectional;

    styles [
      "flat",
    ]

    icon-name: "zoom-original-symbolic";
    tooltip-text: _("Reset Zoom");
    width-request: 80;
  }

  Button {
    action-name: bind template.zoom-in-action-name bidirectional;

    styles [
      "circular",
      "flat",
    ]

    icon-name: "zoom-in-symbolic";
    tooltip-text: _("Zoom In");
  }
}
