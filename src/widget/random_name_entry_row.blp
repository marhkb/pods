using Gtk 4.0;
using Adw 1;

template $PdsRandomNameEntryRow: Adw.EntryRow {
  [suffix]
  Button {
    styles [
      "flat",
    ]

    action-name: "random-name-entry-row.generate";
    icon-name: "view-refresh-symbolic";
    tooltip-text: _("Generate Random Name");
    valign: center;

    accessibility {
      label: _("Generate Random Name");
    }
  }
}
