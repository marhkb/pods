using Gtk 4.0;

template $PdsTextSearchEntry: Widget {
  Image image {
    icon-name: "edit-find-symbolic";
    accessible-role: presentation;
  }

  Text text {
    notify => $on_text_notify() swapped;
    max-width-chars: 32;
  }

  Label info_label {
    styles [
      "dim-label",
      "numeric",
    ]

    label: bind template.info bidirectional;
    xalign: 1;
  }

  Box options_box {
    styles [
      "linked",
    ]

    ToggleButton {
      active: bind template.regex bidirectional;
      icon-name: "regex-symbolic";
      tooltip-text: _("Regular Expression");
      valign: center;

      accessibility {
        label: _("Regular Expression");
      }
    }

    ToggleButton {
      active: bind template.case-sensitive bidirectional;
      icon-name: "uppercase-symbolic";
      tooltip-text: _("Case Sensitive");
      valign: center;

      accessibility {
        label: _("Case Sensitive");
      }
    }

    ToggleButton {
      active: bind template.whole-word bidirectional;
      icon-name: "whole-word-symbolic";
      tooltip-text: _("Whole Word");
      valign: center;

      accessibility {
        label: _("Whole Word");
      }
    }
  }
}
