using Gtk 4.0;
using Adw 1;

template $PdsPropertyRow: Adw.ActionRow {
  title: bind template.key bidirectional;
  activatable: false;

  Label value_label {
    label: bind template.value bidirectional;
    notify::wrap-mode => $on_value_label_notify_wrap_mode() swapped;

    styles [
      "dim-label",
    ]

    hexpand: true;
    justify: right;
    margin-top: 3;
    margin-bottom: 3;
    margin-start: 9;
    selectable: true;
    wrap: true;
    wrap-mode: word_char;
    xalign: 1;
  }
}
